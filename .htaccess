ErrorDocument 404 /404.php

Options -Indexes

RewriteEngine On
RewriteRule ^verify/?$ verify.php [L,QSA,NC]
RewriteRule ^(?:config|database|docs|includes|internal|lang|scripts)(?:/|$) - [F,L,NC]
RewriteRule ^(?:\.git|\.github|\.idea)(?:/|$) - [F,L,NC]

<FilesMatch "^(?:local\.php|\.env|AGENTS\.md|AI_START_HERE\.md|README\.md|VERSION)$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(?:sql|md|json|log|bak|old|orig|save|zip|tar|gz|7z)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://images.unsplash.com; font-src 'self'; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
</IfModule>
